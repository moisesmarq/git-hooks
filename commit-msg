#!/bin/sh

# ==========================================================
# Git Hook: commit-msg
# ----------------------------------------------------------
# Versão: 2.0.1
#
# Objetivo:
# Validar mensagens de commit utilizando o padrão
# Gitmoji + Conventional Commits.
#
# Formatos aceitos:
#
#   🎉 feat(project): inicia o projeto
#   ✨ feat(core): adiciona autenticação
#   feat(core): adiciona autenticação
#
# O Gitmoji é opcional.
# O escopo é obrigatório.
# ==========================================================

HOOK_VERSION="2.0.1"

# ==========================================================
# Configuração
# ==========================================================

# Tipos permitidos (Conventional Commits)
allowed_types='feat|fix|docs|style|refactor|test|chore|perf|build|ci|revert'

# Escopos permitidos
allowed_scopes='project|config|hooks|git|docs|ci|build|deps|release|tests|core|utils|scripts|infra|security|database|ui|api'

# Define se o Gitmoji é obrigatório.
#
# true  = obrigatório
# false = opcional
#
REQUIRE_EMOJI=false

# ==========================================================
# Leitura da mensagem
# ==========================================================

commit_msg_file="$1"

# Lê apenas a primeira linha (título do commit)
IFS= read -r commit_msg < "$commit_msg_file"

# ==========================================================
# Ignora commits automáticos
# ==========================================================

case "$commit_msg" in
    Merge*|Revert*|fixup!*|squash!*)
        exit 0
        ;;
esac

# ==========================================================
# Pré-processamento
# ==========================================================

message="$commit_msg"
emoji=""

case "$message" in
    *" "*)

        first_word="${message%% *}"

        case "$first_word" in

            [[:alnum:]]*)
                ;;

            *)
                emoji="$first_word"
                message="${message#* }"
                ;;

        esac
        ;;
esac

# ==========================================================
# Validação do Gitmoji
# ==========================================================

if [ "$REQUIRE_EMOJI" = "true" ] && [ -z "$emoji" ]; then

    echo
    echo "❌ Gitmoji obrigatório!"
    echo
    echo "Formato esperado:"
    echo "  emoji tipo(escopo): descrição"
    echo
    echo "Exemplo:"
    echo "  ✨ feat(core): adiciona autenticação"
    echo

    exit 1
fi

# ==========================================================
# Regex
# ==========================================================

regex="^(${allowed_types})\\((${allowed_scopes})\\): .+$"

# ==========================================================
# Validação
# ==========================================================

if ! printf '%s\n' "$message" | grep -Eq "$regex"; then

    echo
    echo "❌ Mensagem de commit inválida!"
    echo

    echo "Mensagem recebida:"
    echo "  $commit_msg"
    echo

    echo "Formato esperado:"
    echo "  [emoji] tipo(escopo): descrição"
    echo

    echo "Exemplos válidos:"
    echo "  🎉 feat(project): inicia o projeto"
    echo "  ✨ feat(core): adiciona autenticação"
    echo "  🐛 fix(api): corrige retorno de erro"
    echo "  📝 docs(docs): atualiza README"
    echo "  🎨 style(ui): ajusta layout"
    echo "  ♻️ refactor(core): reorganiza serviço"
    echo "  ✅ test(tests): adiciona testes"
    echo "  🔧 chore(config): ajusta configuração"
    echo "  ⚡ perf(database): otimiza consulta"
    echo "  📦 build(deps): atualiza dependências"
    echo "  🚀 ci(ci): configura pipeline"
    echo "  ⏪ revert(core): reverte alteração"
    echo

    echo "Tipos permitidos:"
    echo "  feat"
    echo "  fix"
    echo "  docs"
    echo "  style"
    echo "  refactor"
    echo "  test"
    echo "  chore"
    echo "  perf"
    echo "  build"
    echo "  ci"
    echo "  revert"
    echo

    echo "Escopos permitidos:"
    echo "  project"
    echo "  config"
    echo "  hooks"
    echo "  git"
    echo "  docs"
    echo "  ci"
    echo "  build"
    echo "  deps"
    echo "  release"
    echo "  tests"
    echo "  core"
    echo "  utils"
    echo "  scripts"
    echo "  infra"
    echo "  security"
    echo "  database"
    echo "  ui"
    echo "  api"
    echo

    echo "Versão do hook:"
    echo "  $HOOK_VERSION"
    echo

    exit 1
fi

exit 0
