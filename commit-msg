#!/bin/sh

# ==========================================================
# Git Hook: commit-msg
# ----------------------------------------------------------
# Versão: 2.0.0
#
# Objetivo:
# Validar mensagens de commit utilizando o padrão
# Conventional Commits com suporte opcional ao Gitmoji.
#
# Formatos aceitos:
#
#   feat(core): adiciona autenticação
#   ✨ feat(core): adiciona autenticação
#
# O emoji é opcional.
# O escopo é obrigatório.
# ==========================================================

HOOK_VERSION="2.0.0"

# ==========================================================
# Configuração
# ==========================================================

# Tipos permitidos
allowed_types='feat|fix|docs|style|refactor|test|chore|perf|build|ci|revert'

# Escopos permitidos
allowed_scopes='project|config|hooks|git|docs|ci|build|deps|release|tests|core|utils|scripts|infra|security|database|ui|api'

# ==========================================================
# Leitura da mensagem
# ==========================================================

commit_msg_file="$1"

# Lê somente a primeira linha (título do commit)
IFS= read -r commit_msg < "$commit_msg_file"

# ==========================================================
# Ignora commits automáticos
# ==========================================================

case "$commit_msg" in
    Merge*|Revert*|fixup!*|squash!*)
        exit 0
        ;;
esac

# ==========================================================
# Regex
# ==========================================================
#
# Formatos aceitos:
#
# feat(core): descrição
# ✨ feat(core): descrição
#
# O emoji (qualquer símbolo não iniciado por letra ou número)
# é opcional.
#
# ==========================================================

regex='^([^[:alnum:][:space:]]+[[:space:]]+)?('"$allowed_types"')\(('"$allowed_scopes"')\): .+$'

# ==========================================================
# Validação
# ==========================================================

if ! printf '%s\n' "$commit_msg" | grep -Eq "$regex"; then

    echo
    echo "❌ Mensagem de commit inválida!"
    echo

    echo "Mensagem recebida:"
    echo "  $commit_msg"
    echo

    echo "Formato esperado:"
    echo "  [emoji] tipo(escopo): descrição"
    echo

    echo "Exemplos válidos:"
    echo "  feat(core): adiciona autenticação"
    echo "  ✨ feat(core): adiciona autenticação"
    echo "  🐛 fix(api): corrige retorno de erro"
    echo "  📝 docs(docs): atualiza README"
    echo "  🔧 chore(config): ajusta configuração"
    echo

    echo "Tipos permitidos:"
    echo "  feat"
    echo "  fix"
    echo "  docs"
    echo "  style"
    echo "  refactor"
    echo "  test"
    echo "  chore"
    echo "  perf"
    echo "  build"
    echo "  ci"
    echo "  revert"
    echo

    echo "Escopos permitidos:"
    echo "  project"
    echo "  config"
    echo "  hooks"
    echo "  git"
    echo "  docs"
    echo "  ci"
    echo "  build"
    echo "  deps"
    echo "  release"
    echo "  tests"
    echo "  core"
    echo "  utils"
    echo "  scripts"
    echo "  infra"
    echo "  security"
    echo "  database"
    echo "  ui"
    echo "  api"
    echo

    echo "Versão do hook: $HOOK_VERSION"
    echo

    exit 1
fi

exit 0
